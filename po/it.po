msgid "Lower-cases every word except proper nouns and the words you list as exceptions."
msgstr "Mette in minuscolo ogni parola tranne i nomi propri e le parole che elenchi come eccezioni."

#: app/catalog.c:212
msgid "Search and replace in bulk"
msgstr "Cerca e sostituisci in blocco"

#: app/catalog.c:213
msgid "Applies a list of substitutions across many files at once."
msgstr "Applica una lista di sostituzioni su molti file in una volta sola."

#: app/catalog.c:215
#, c-format
msgid "Create the plain text tier (%flo)"
msgstr "Crea la tier di testo semplice (%flo)"

#: app/catalog.c:216
msgid "Adds a simplified version of each utterance, without codes or annotations."
msgstr "Aggiunge una versione semplificata di ogni enunciato, senza codici né annotazioni."

#: app/catalog.c:218
#, c-format
msgid "Create the orthography tier (%ort)"
msgstr "Crea la tier ortografica (%ort)"

#: app/catalog.c:219
msgid "Adds the standard spelling of what was said."
msgstr "Aggiunge la grafia standard di quanto è stato detto."

#: app/catalog.c:220
msgid "Compare against a reference script"
msgstr "Confronta con un testo di riferimento"

#: app/catalog.c:221
msgid "Aligns a transcript with the script the speaker was reading, for reading studies."
msgstr "Allinea una trascrizione con il testo che il parlante stava leggendo, per gli studi sulla lettura."

