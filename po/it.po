#: app/catalog.c:175
msgid "Praat to CHAT"
msgstr "Da Praat a CHAT"

#: app/catalog.c:176
msgid "Imports a Praat TextGrid as a CHAT transcript."
msgstr "Importa un TextGrid di Praat come trascrizione CHAT."

#: app/catalog.c:177
msgid "LENA to CHAT"
msgstr "Da LENA a CHAT"

