#: app/main.c:262
msgid "Choose at least one file to analyse."
msgstr "Scegli almeno un file da analizzare."

#: app/main.c:268
#, c-format
msgid "%s needs to know which speaker to analyse. Pick one under “Who to analyse”."
msgstr "%s ha bisogno di sapere quale parlante analizzare. Sceglilo in «Chi analizzare»."

#: app/main.c:274
#, c-format
msgid "%s needs the language of the transcript."
msgstr "%s ha bisogno della lingua della trascrizione."

#: app/main.c:281
#, c-format
msgid "These files have no %mor tier, which this analysis reads. Run “Morphological analysis” (mor) first, or work on the words of the main tier instead."
msgstr "Questi file non hanno la tier %mor, che questa analisi legge. Esegui prima «Analisi morfologica» (mor), oppure lavora sulle parole della tier principale."

#: app/main.c:284 app/main.c:302
msgid "Use words instead"
msgstr "Usa le parole"

#: app/main.c:304
#, c-format
msgid "The files have no %mor tier. Run “Morphological analysis” (mor) on them first, or switch to counting the words of the main tier."
msgstr "I file non hanno la tier %mor. Esegui prima su di essi «Analisi morfologica» (mor), oppure passa a contare le parole della tier principale."

#: app/main.c:308
msgid "Pick a speaker under “Who to analyse”."
msgstr "Scegli un parlante in «Chi analizzare»."

#: app/main.c:310
msgid "Choose the language of the transcript."
msgstr "Scegli la lingua della trascrizione."

#: app/main.c:312
msgid "This file is not a valid CHAT transcript. Run “Check the file is valid” (check) to see what is wrong."
msgstr "Questo file non è una trascrizione CHAT valida. Esegui «Verifica che il file sia valido» (check) per vedere cosa non va."

#: app/main.c:316
#, c-format
msgid "The program stopped with code %d. See the Messages tab."
msgstr "Il programma si è fermato con codice %d. Vedi la scheda Messaggi."

#: app/main.c:330
#, c-format
msgid "Added -t%mor: the analysis will count words on the main tier."
msgstr "Aggiunto -t%mor: l'analisi conterà le parole della tier principale."

#: app/main.c:378
msgid "failed"
msgstr "non riuscito"

#: app/main.c:386
#, c-format
msgid "done in %.1f s"
msgstr "completato in %.1f s"

#: app/main.c:400
#, c-format
msgid "%u file created"
msgid_plural "%u files created"
msgstr[0] "%u file creato"
msgstr[1] "%u file creati"

#: app/main.c:436
msgid "running…"
msgstr "in esecuzione…"

#: app/main.c:455
#, c-format
msgid "Showing %s"
msgstr "Mostro %s"

#: app/main.c:458
msgid "This file is not readable as text."
msgstr "Questo file non è leggibile come testo."

#: app/main.c:459
msgid "Could not open the file."
msgstr "Non è stato possibile aprire il file."

#: app/main.c:525
msgid "Choose the folder with your transcripts"
msgstr "Scegli la cartella con le trascrizioni"

#: app/main.c:672
msgid "Command line copied."
msgstr "Riga di comando copiata."

#: app/main.c:738
msgid "Choose an analysis"
msgstr "Scegli un'analisi"

#: app/main.c:740
msgid "Pick one from the list on the left. “Start here” holds the six commands you need most often."
msgstr "Scegline una dall'elenco a sinistra. In «Si comincia da qui» ci sono i sei comandi che servono più spesso."

#: app/main.c:745
msgid "TalkBank"
msgstr "TalkBank"

#: app/main.c:758
msgid "What it does"
msgstr "Che cosa fa"

#: app/main.c:760
msgid "Example from the manual"
msgstr "Esempio dal manuale"

#: app/main.c:766
msgid "All options for this program"
msgstr "Tutte le opzioni di questo programma"

#: app/main.c:777
#, c-format
msgid "%u file selected"
msgid_plural "%u files selected"
msgstr[0] "%u file selezionato"
msgstr[1] "%u file selezionati"

#: app/main.c:778
msgid "Files"
msgstr "File"

#: app/main.c:782
msgid "Folder…"
msgstr "Cartella…"

#: app/main.c:784
msgid "Select all"
msgstr "Seleziona tutti"

#: app/main.c:792
msgid "This folder has no files"
msgstr "Questa cartella non contiene file"

#: app/main.c:793
msgid "Use the Folder button to go where your transcripts are."
msgstr "Usa il pulsante Cartella per andare dove sono le tue trascrizioni."

#: app/main.c:800
msgid "not a transcript"
msgstr "non è una trascrizione"

#: app/main.c:814
msgid "Show the file"
msgstr "Mostra il file"

#: app/main.c:826
msgid "Who to analyse"
msgstr "Chi analizzare"

#: app/main.c:827
msgid "Read from the @Participants header of the files you selected. Leave everything off to analyse all speakers."
msgstr "Letti dall'intestazione @Participants dei file selezionati. Lascia tutto disattivato per analizzare tutti i parlanti."

#: app/main.c:831
msgid "No speaker found yet"
msgstr "Nessun parlante ancora trovato"

#: app/main.c:832
msgid "Select a CHAT file above and the speakers will appear here."
msgstr "Seleziona un file CHAT qui sopra e i parlanti compariranno qui."

#: app/main.c:859
msgid "Options"
msgstr "Opzioni"

#: app/main.c:873
msgid "Language of the transcript"
msgstr "Lingua della trascrizione"

#: app/main.c:874
msgid "Rule set this analysis needs (+l)"
msgstr "Insieme di regole richiesto da questa analisi (+l)"

#: app/main.c:884
msgid "Word to search for (+s)"
msgstr "Parola da cercare (+s)"

#: app/main.c:890
msgid "Extra tiers to include"
msgstr "Tier aggiuntive da includere"

#: app/main.c:892
#, c-format
msgid "Annotation lines below each utterance: %mor is morphology, %gra syntax"
msgstr "Righe di annotazione sotto ogni enunciato: %mor è la morfologia, %gra la sintassi"

#: app/main.c:910
msgid "Include repetitions and retracings"
msgstr "Includi ripetizioni e riformulazioni"

#: app/main.c:911
msgid "CLAN leaves them out by default (+r6)"
msgstr "CLAN le esclude per impostazione predefinita (+r6)"

#: app/main.c:912
msgid "Ignore upper and lower case"
msgstr "Ignora maiuscole e minuscole"

#: app/main.c:913
msgid "Treat all files as one corpus"
msgstr "Tratta tutti i file come un unico corpus"

#: app/main.c:914
msgid "One combined result instead of one per file (+u)"
msgstr "Un risultato complessivo invece di uno per file (+u)"

#: app/main.c:915
msgid "Include subfolders"
msgstr "Includi le sottocartelle"

#: app/main.c:916
msgid "Also save the result to a file"
msgstr "Salva il risultato anche su file"

#: app/main.c:917
msgid "Creates a .cex file next to your data (+f)"
msgstr "Crea un file .cex accanto ai tuoi dati (+f)"

#: app/main.c:919
msgid "Spreadsheet layout"
msgstr "Formato foglio di calcolo"

#: app/main.c:922
msgid "Other options, typed"
msgstr "Altre opzioni, digitate"

#: app/main.c:1025
msgid "The language will be applied next time you start TalkBank."
msgstr "La lingua sarà applicata al prossimo avvio di TalkBank."

#: app/main.c:1068 app/main.c:1308
msgid "Preferences"
msgstr "Preferenze"

#: app/main.c:1072
msgid "Appearance"
msgstr "Aspetto"

#: app/main.c:1075 app/main.c:1085
msgid "Same as the system"
msgstr "Come il sistema"

#: app/main.c:1077
msgid "Language"
msgstr "Lingua"

#: app/main.c:1085
msgid "Light"
msgstr "Chiaro"

#: app/main.c:1085
msgid "Dark"
msgstr "Scuro"

#: app/main.c:1087
msgid "Theme"
msgstr "Tema"

#: app/main.c:1094
msgid "Output text size"
msgstr "Dimensione del testo dell'output"

#: app/main.c:1101
msgid "Behaviour"
msgstr "Comportamento"

#: app/main.c:1103
msgid "Show the command line"
msgstr "Mostra la riga di comando"

#: app/main.c:1104
msgid "The line you could type in a terminal to get the same result"
msgstr "La riga che potresti digitare in un terminale per ottenere lo stesso risultato"

#: app/main.c:1105
msgid "Warn before running"
msgstr "Avvisa prima di eseguire"

#: app/main.c:1106
msgid "Check that the files have what the analysis needs"
msgstr "Controlla che i file abbiano quello che serve all'analisi"

#: app/main.c:1107
msgid "Include repetitions by default"
msgstr "Includi le ripetizioni per impostazione predefinita"

#: app/main.c:1108
msgid "Save results to a file by default"
msgstr "Salva i risultati su file per impostazione predefinita"

#: app/main.c:1122
msgid "Folders"
msgstr "Cartelle"

#: app/main.c:1124 app/main.c:1302
msgid "Working folder"
msgstr "Cartella di lavoro"

#: app/main.c:1127
msgid "Change…"
msgstr "Cambia…"

#: app/main.c:1134
msgid "CLAN lib folder"
msgstr "Cartella lib di CLAN"

#: app/main.c:1140
msgid "CLAN programs"
msgstr "Programmi CLAN"

#: app/main.c:1159
msgid "Graphical front-end for the CLAN programs (Computerized Language ANalysis), part of the CHILDES/TalkBank project."
msgstr "Interfaccia grafica per i programmi CLAN (Computerized Language ANalysis), parte del progetto CHILDES/TalkBank."

#: app/main.c:1169 app/main.c:1307
msgid "Recent commands"
msgstr "Comandi recenti"

#: app/main.c:1177
msgid "Nothing has been run yet in this session."
msgstr "In questa sessione non è ancora stato eseguito nulla."

#: app/main.c:1211
msgid "Output"
msgstr "Output"

#: app/main.c:1222
msgid "Messages"
msgstr "Messaggi"

#: app/main.c:1234
msgid "New files"
msgstr "File nuovi"

#: app/main.c:1272 app/main.c:1373
msgid "Analyses"
msgstr "Analisi"

#: app/main.c:1280
msgid "Search an analysis"
msgstr "Cerca un'analisi"

#: app/main.c:1309
msgid "About TalkBank"
msgstr "Informazioni su TalkBank"

#: app/main.c:1355
msgid "Copy the command line"
msgstr "Copia la riga di comando"

#: app/main.c:1363
msgid "Run"
msgstr "Esegui"

#: app/catalog.c:9
msgid "Count words"
msgstr "Conta le parole"

#: app/catalog.c:10
msgid "Counts how many times each word appears and computes the type/token ratio, the usual measure of vocabulary variety."
msgstr "Conta quante volte compare ogni parola e calcola il rapporto tipi/occorrenze, la misura abituale della varietà del vocabolario."

#: app/catalog.c:13
msgid "Mean length of utterance (MLU)"
msgstr "Lunghezza media dell'enunciato (MLU)"

#: app/catalog.c:14
#, c-format
msgid "Average number of morphemes per utterance, the classic index of grammatical development. It counts on the %mor tier, so the file must have been run through MOR first."
msgstr "Numero medio di morfemi per enunciato, l'indice classico dello sviluppo grammaticale. Conta sulla tier %mor, quindi il file deve prima essere passato per MOR."

#: app/catalog.c:17
msgid "Find a word in context"
msgstr "Trova una parola nel suo contesto"

#: app/catalog.c:18
msgid "Shows every line containing the word you searched for, together with the surrounding utterances, so you can read it in context."
msgstr "Mostra ogni riga che contiene la parola cercata, insieme agli enunciati circostanti, così la puoi leggere nel contesto."

#: app/catalog.c:21
msgid "Search word combinations"
msgstr "Cerca combinazioni di parole"

#: app/catalog.c:22
msgid "Finds sequences and combinations of words. Use ^ for \"immediately followed by\", + for \"or\": +s\"kitty^kitty\" finds kitty said twice in a row."
msgstr "Trova sequenze e combinazioni di parole. Usa ^ per «seguito immediatamente da», + per «oppure»: +s\"kitty^kitty\" trova kitty detto due volte di fila."

#: app/catalog.c:25
msgid "Extract marked sections"
msgstr "Estrai le sezioni marcate"

#: app/catalog.c:26
msgid "Pulls out the parts of the transcript marked with @bg and @eg headers, for example a single activity or task, so you can analyse it separately."
msgstr "Estrae le parti della trascrizione marcate con le intestazioni @bg e @eg, per esempio una singola attività, così da poterle analizzare a parte."

#: app/catalog.c:29
msgid "Check the file is valid"
msgstr "Verifica che il file sia valido"

#: app/catalog.c:30
msgid "Verifies that the transcript follows the CHAT rules and reports every error with its line number. Run this before any analysis."
msgstr "Verifica che la trascrizione rispetti le regole CHAT e segnala ogni errore con il numero di riga. Da eseguire prima di qualsiasi analisi."

#: app/catalog.c:35
msgid "Word frequency by position"
msgstr "Frequenza delle parole per posizione"

#: app/catalog.c:36
msgid "Counts words according to where they sit in the utterance: first, second, last. Useful for studying word order."
msgstr "Conta le parole secondo la posizione che occupano nell'enunciato: prima, seconda, ultima. Utile per studiare l'ordine delle parole."

#: app/catalog.c:38
msgid "Word frequency inside each section"
msgstr "Frequenza delle parole in ogni sezione"

#: app/catalog.c:39
msgid "Like counting words, but reported separately for each marked section (gem)."
msgstr "Come il conteggio delle parole, ma riportato separatamente per ogni sezione marcata (gem)."

#: app/catalog.c:41
msgid "Sound frequency"
msgstr "Frequenza dei suoni"

#: app/catalog.c:42
#, c-format
msgid "Counts the phonemes on the %pho tier and shows where in the word each one occurs."
msgstr "Conta i fonemi sulla tier %pho e mostra in che punto della parola compare ciascuno."

#: app/catalog.c:44
msgid "Length histograms"
msgstr "Istogrammi di lunghezza"

#: app/catalog.c:45
msgid "Distribution of the length of words, utterances and turns, in characters and morphemes."
msgstr "Distribuzione della lunghezza di parole, enunciati e turni, in caratteri e in morfemi."

#: app/catalog.c:47
msgid "Longest words and utterances"
msgstr "Parole ed enunciati più lunghi"

#: app/catalog.c:48
msgid "Finds the longest words, or with +g2 the longest utterances. Used for the MLU of the five longest utterances (MLU5)."
msgstr "Trova le parole più lunghe, o con +g2 gli enunciati più lunghi. Si usa per la MLU dei cinque enunciati più lunghi (MLU5)."

#: app/catalog.c:51
msgid "Lexical diversity (VOCD)"
msgstr "Diversità lessicale (VOCD)"

#: app/catalog.c:52
msgid "Computes the D index, a measure of vocabulary richness that, unlike the type/token ratio, does not depend on sample length."
msgstr "Calcola l'indice D, una misura di ricchezza lessicale che, a differenza del rapporto tipi/occorrenze, non dipende dalla lunghezza del campione."

#: app/catalog.c:55
msgid "Table of parts of speech"
msgstr "Tabella delle parti del discorso"

#: app/catalog.c:56
msgid "Spreadsheet with how often each part of speech and each bound morpheme is used."
msgstr "Foglio di calcolo con quanto spesso viene usata ogni parte del discorso e ogni morfema legato."

#: app/catalog.c:58
msgid "Table of MC codes"
msgstr "Tabella dei codici MC"

#: app/catalog.c:59
msgid "Spreadsheet of the coded categories entered with the coder mode."
msgstr "Foglio di calcolo delle categorie codificate inserite con la modalità coder."

#: app/catalog.c:61
msgid "Repeated lines"
msgstr "Righe ripetute"

#: app/catalog.c:62
msgid "Reports lines that appear more than once, handy for cleaning up word lists."
msgstr "Segnala le righe che compaiono più di una volta, comodo per ripulire liste di parole."

#: app/catalog.c:66
msgid "Mean length of turn (MLT)"
msgstr "Lunghezza media del turno (MLT)"

#: app/catalog.c:67
msgid "Counts utterances, turns and words per speaker, and their ratios. Unlike MLU it also counts lines with unintelligible material (xxx)."
msgstr "Conta enunciati, turni e parole per parlante, e i loro rapporti. A differenza di MLU conta anche le righe con materiale incomprensibile (xxx)."

#: app/catalog.c:70
msgid "Full child language profile"
msgstr "Profilo completo del linguaggio infantile"

#: app/catalog.c:71
msgid "Runs a whole battery of measures at once (MLU, DSS, IPSyn, vocabulary, errors) and compares the child against a reference database. The best starting point for a clinical profile."
msgstr "Esegue in una volta sola un'intera batteria di misure (MLU, DSS, IPSyn, vocabolario, errori) e confronta il bambino con un database di riferimento. Il punto di partenza migliore per un profilo clinico."

#: app/catalog.c:75
msgid "Developmental Sentence Score"
msgstr "Developmental Sentence Score (DSS)"

#: app/catalog.c:76
msgid "Assigns the DSS score, which weights the grammatical structures used in 50 sentences. Needs a speaker and a language."
msgstr "Assegna il punteggio DSS, che pesa le strutture grammaticali usate in 50 frasi. Richiede un parlante e una lingua."

#: app/catalog.c:79
msgid "Index of Productive Syntax"
msgstr "Index of Productive Syntax (IPSyn)"

#: app/catalog.c:80
#, c-format
msgid "Scores the variety of syntactic structures produced, adding a %syn tier to the file."
msgstr "Valuta la varietà delle strutture sintattiche prodotte, aggiungendo al file una tier %syn."

#: app/catalog.c:82
msgid "Fluency and disfluency measures"
msgstr "Misure di fluenza e disfluenza"

#: app/catalog.c:83
msgid "Counts repetitions, revisions, filled pauses and blocks, the measures used in stuttering research."
msgstr "Conta ripetizioni, revisioni, pause piene e blocchi, le misure usate nella ricerca sulla balbuzie."

#: app/catalog.c:85
msgid "SUGAR measures"
msgstr "Misure SUGAR"

#: app/catalog.c:86
msgid "MLU, total number of words, clauses per sentence and words per sentence, following the SUGAR protocol."
msgstr "MLU, numero totale di parole, proposizioni per frase e parole per frase, secondo il protocollo SUGAR."

#: app/catalog.c:89
msgid "Summary profile with comparison"
msgstr "Profilo riassuntivo con confronto"

#: app/catalog.c:90
msgid "Spreadsheet with duration, MLU, type/token ratio, error percentages, parts of speech, repetitions and revisions, compared against a reference database."
msgstr "Foglio di calcolo con durata, MLU, rapporto tipi/occorrenze, percentuali di errore, parti del discorso, ripetizioni e revisioni, confrontati con un database di riferimento."

#: app/catalog.c:93
msgid "Summary profile, file by file"
msgstr "Profilo riassuntivo, file per file"

#: app/catalog.c:94
msgid "Same measures as the summary profile, but reported separately for each file."
msgstr "Le stesse misure del profilo riassuntivo, ma riportate separatamente per ogni file."

#: app/catalog.c:96
msgid "Speech duration"
msgstr "Durata del parlato"

#: app/catalog.c:97
msgid "Uses the timestamps linked to the media to compute words and utterances per minute of speech."
msgstr "Usa i tempi collegati al file multimediale per calcolare parole ed enunciati al minuto di parlato."

#: app/catalog.c:99
msgid "Parent-child exchanges"
msgstr "Scambi genitore-bambino"

#: app/catalog.c:100
msgid "Measures how much each speaker repeats, expands or changes what the other just said. Needs the two speakers given with +b (source) and +c (response)."
msgstr "Misura quanto ogni parlante ripete, espande o modifica ciò che l'altro ha appena detto. Richiede i due parlanti indicati con +b (fonte) e +c (risposta)."

#: app/catalog.c:103
msgid "What follows what"
msgstr "Che cosa segue che cosa"

#: app/catalog.c:104
msgid "Contingency table showing which code tends to follow which other code."
msgstr "Tabella di contingenza che mostra quale codice tende a seguire quale altro codice."

#: app/catalog.c:106
msgid "Average distance between items"
msgstr "Distanza media fra elementi"

#: app/catalog.c:107
msgid "How many utterances typically separate two occurrences of the same word or code."
msgstr "Quanti enunciati separano di solito due occorrenze della stessa parola o dello stesso codice."

#: app/catalog.c:109
msgid "Words occurring together"
msgstr "Parole che ricorrono insieme"

#: app/catalog.c:110
msgid "Lists the clusters of words that recur next to each other."
msgstr "Elenca i gruppi di parole che ricorrono una accanto all'altra."

#: app/catalog.c:112
msgid "Chains of codes across turns"
msgstr "Catene di codici attraverso i turni"

#: app/catalog.c:113
msgid "Follows a code through the conversation to see how long it stays active."
msgstr "Segue un codice lungo la conversazione per vedere quanto resta attivo."

#: app/catalog.c:115
msgid "Transcription reliability"
msgstr "Affidabilità della trascrizione"

#: app/catalog.c:116
msgid "Compares two transcriptions of the same recording and reports where they disagree."
msgstr "Confronta due trascrizioni della stessa registrazione e segnala dove divergono."

#: app/catalog.c:120
msgid "List the sections of a file"
msgstr "Elenca le sezioni di un file"

#: app/catalog.c:121
msgid "Shows the structure of the gems in the transcript, to see what can be extracted."
msgstr "Mostra la struttura dei gem nella trascrizione, per vedere che cosa si può estrarre."

#: app/catalog.c:123
msgid "Repetitions between speakers"
msgstr "Ripetizioni fra parlanti"

#: app/catalog.c:124
msgid "Finds where one speaker repeats what another just said."
msgstr "Trova i punti in cui un parlante ripete quello che un altro ha appena detto."

#: app/catalog.c:126
msgid "Mark reformulations"
msgstr "Marca le riformulazioni"

#: app/catalog.c:127
msgid "Adds a %ret tier coding retracings and self-corrections."
msgstr "Aggiunge una tier %ret che codifica riformulazioni e autocorrezioni."

#: app/catalog.c:129
msgid "Compare target and actual pronunciation"
msgstr "Confronta pronuncia attesa ed effettiva"

#: app/catalog.c:130
#, c-format
msgid "Matches the words on the %mod tier against how they were actually produced on %pho."
msgstr "Confronta le parole della tier %mod con come sono state effettivamente prodotte su %pho."

#: app/catalog.c:132
msgid "Join wrapped tiers"
msgstr "Riunisci le tier spezzate"

#: app/catalog.c:133
msgid "Puts tiers split over several lines back onto a single line."
msgstr "Rimette su una sola riga le tier divise su più righe."

#: app/catalog.c:135
msgid "Number the lines"
msgstr "Numera le righe"

#: app/catalog.c:136
msgid "Adds line numbers, useful when reporting errors to a colleague."
msgstr "Aggiunge i numeri di riga, utile per segnalare errori a un collega."

#: app/catalog.c:140
#, c-format
msgid "Morphological analysis (creates %mor)"
msgstr "Analisi morfologica (crea %mor)"

#: app/catalog.c:141
#, c-format
msgid "Adds the %mor tier with part of speech and morphemes for every word. This is the step that unlocks MLU, DSS, IPSyn and the profiles. Needs a MOR grammar for the language of the transcript."
msgstr "Aggiunge la tier %mor con parte del discorso e morfemi per ogni parola. È il passaggio che sblocca MLU, DSS, IPSyn e i profili. Richiede una grammatica MOR per la lingua della trascrizione."

#: app/catalog.c:145
#, c-format
msgid "Disambiguate %mor"
msgstr "Disambigua %mor"

#: app/catalog.c:146
msgid "Where MOR proposed several analyses for a word, POST picks the right one using the context."
msgstr "Dove MOR ha proposto più analisi per una parola, POST sceglie quella giusta usando il contesto."

#: app/catalog.c:148
#, c-format
msgid "Grammatical relations (creates %gra)"
msgstr "Relazioni grammaticali (crea %gra)"

#: app/catalog.c:149
#, c-format
msgid "Adds the %gra tier with the syntactic dependencies between words: subject, object, modifier."
msgstr "Aggiunge la tier %gra con le dipendenze sintattiche fra le parole: soggetto, oggetto, modificatore."

#: app/catalog.c:151
msgid "Fix leftover errors after POST"
msgstr "Corregge gli errori rimasti dopo POST"

#: app/catalog.c:152
msgid "Corrects the analyses POST could not resolve."
msgstr "Corregge le analisi che POST non è riuscito a risolvere."

#: app/catalog.c:153
msgid "Compare %trn with %mor"
msgstr "Confronta %trn con %mor"

#: app/catalog.c:154
msgid "Reports where the manual coding on %trn disagrees with the automatic %mor."
msgstr "Segnala dove la codifica manuale su %trn diverge da quella automatica su %mor."

#: app/catalog.c:156
msgid "Inspect a POST database"
msgstr "Ispeziona un database POST"

#: app/catalog.c:157
msgid "Prints the contents of a trained POST database."
msgstr "Stampa il contenuto di un database POST addestrato."

#: app/catalog.c:158
msgid "Train a POST database"
msgstr "Addestra un database POST"

#: app/catalog.c:159
