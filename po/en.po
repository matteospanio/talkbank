msgstr ""

#: app/catalog.c:141
#, c-format
msgid "Adds the %mor tier with part of speech and morphemes for every word. This is the step that unlocks MLU, DSS, IPSyn and the profiles. Needs a MOR grammar for the language of the transcript."
msgstr ""

#: app/catalog.c:145
#, c-format
msgid "Disambiguate %mor"
msgstr ""

