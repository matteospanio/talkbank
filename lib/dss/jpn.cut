###############################################################################
#  adjectival nouns  D        #
###############################################################################
RULENAME: adjnoun
# AN da  AN ni  AN na  D4
 FOCUS: adj|*-Pos-S1^aux|だ-Inf-S
 POINTS: D4

###############################################################################
#  copula  D
###############################################################################
RULENAME: cop
# janai de  D3      ######## de (cop-CONN) not separated from post ptl
 FOCUS: aux|だ-Inf-S^aux|ない-Inf-S
 POINTS: D3
# datta na ni  D4   ######## na ni not separated from da
 FOCUS: aux|だ-Inf-S^aux|た-Inf-S
 POINTS: D4
# ja  D5                 ######## ja not separated from da
# da  D1
 FOCUS: aux|だ-Inf-S
 POINTS: D1


