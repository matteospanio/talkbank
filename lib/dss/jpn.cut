 POINTS: B1 F3



#### AN+na+N   F5
# kiree na hito F5
 FOCUS: adj|*-Pos-S1^aux|だ-Inf-S^noun|*
 POINTS: D4 F5



#### V+ SNR
####### first exclude noda
# no da  (no QUD point)
 FOCUS: sconj|の^aux|だ-Inf-S
 POINTS: B1 D1
# no datta  (no QUD point)
 FOCUS: sconj|の^aux|だ-Inf-S^aux|た-Inf-S
 POINTS: B1 D4
####### then search for SNR
# (chigau/chiisai) no ga (atta)  F5 G1
 FOCUS: sconj|の^adp|ga+sconj|の^adp|ni
 POINTS: F5 G1
# (chigau/chiisai) no to (asonda)  F5 G2
 FOCUS: sconj|の^adp|to+sconj|の^adp|de
 POINTS: F5 G2
# (chigau/chiisai) no o (mita)  F5 G3
 FOCUS: sconj|の^adp|o+sconj|の^adp|kara
 POINTS: F5 G3
# (chigau/chiisai) no o (mita)  F5 G5
 FOCUS: sconj|の^adp|made
 POINTS: F5 G5
# (chigau) no mita  F5
 FOCUS: sconj|no^verb|*
 POINTS: F5


###############################################################################
# verbal adjectives C   #
###############################################################################
RULENAME: vadj
# oishikatta  C4
 FOCUS: adj|*-Pos-S1^aux|た-Inf-S
 POINTS: C4
# oishiku nakatta  C3
 FOCUS: adj|*-Pos-S1^aux|無い-Pos-S1^aux|た-Inf-S
 POINTS: C3
# oishiku nai  C3
 FOCUS: adj|*-Pos-S1^aux|無い-Pos-S1
 POINTS: C3
# oishiku C3          #######  ADV not separated from PRES
# oishii  C1
 FOCUS: adj|*-Pos-S1
 POINTS: C1


###############################################################################
#  verb middle inflection  A
###############################################################################
RULENAME: vmiddle
################################################## PASS
# taberareru  (pass)  A4
# taberaretai  A2 A4
# taberaretaku nakatta   B1 A1 A2 A4
