# N+VGER  ekaki   F5
# V+V  F5


###############################################################################
#  case & focus & quotation particles  G
###############################################################################
RULENAME: case-foc-quot-ptl
# ga ni wa mo  G1
 FOCUS: adp|が+adp|に+adp|は+adp|も
 POINTS: G1
# kara o dake toQ G3
 FOCUS: adp|から+adp|を+adp|だけ+adp|と^verb|思う-Inf-S+adp|と^verb|言う-Inf-S
 POINTS: G3
# to de tteQ G2
 FOCUS: adp|と+adp|で+adp|って+part|って
 POINTS: G2
# made kurai shika G5
 FOCUS: adp|まで+adp|くらい+adp|しか
 POINTS: G5


###############################################################################
#  final particles  J       #
###############################################################################
RULENAME: final-ptl
# jan J5
 FOCUS: part|じゃん
 POINTS: J5
# yo-ne kke J4
 FOCUS: part|よ^part|ね+part|け
 POINTS: J4
# no-yo  J3
 FOCUS: sconj|の^part|よ
 POINTS: J3
# kanaa mon J2           ###### mon not recognised
 FOCUS: part|か^part|な
 POINTS: J2
# ka naa J2
 FOCUS: part|か+part|な
 POINTS: J2
# yo ne no  J1
 FOCUS: part|よ+part|ね+sconj|の
 POINTS: J1


###############################################################################
#  adverbs  H       #
###############################################################################
RULENAME: adv
