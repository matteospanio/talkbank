#Points:  |VM|VL|ADJ|COP|CNJ|NP|CASFQ|ADV|SMOD|FINP|
#              A     B   C        D     E     F        G         H           I        J
#+vmiddle +vlast +vadj +adjnoun +cop +comp +conj +conj-ptl +np +case-ptl +foc-ptl +adv +final-ptl +smod
#
#######################################################################
STARTRULES: +punc +nphrase +adjnoun +cop +comp +vmiddle +vlast +vadj +conj +case-foc-quot-ptl +adv +final-ptl +smod
#######################################################################
RULENAME: punc
 FOCUS: .+?
 POINTS:

###############################################################################
#  elaborated noun phrase  F  #       (combinations before isolated use)
###############################################################################
RULENAME: nphrase
#to exclude "no da" constructions###
 FOCUS: sconj|の^aux|だ-Inf-S
 POINTS:

#### N+no+(N)  F2
# Papa no (kutsu)  F2
 FOCUS: ptl:attr|no=GEN
 POINTS: F2

#### A+N  F2
# oishiku nai gohan  F2
 FOCUS: adj|*-Pos-S1^adj|無い-Pos-S1^noun|*
 POINTS: F2 C3
# oishii gohan  F2
 FOCUS: adj|*-Pos-S1^noun|*
 POINTS: F2 C1
# oishikatta gohan F2
 FOCUS: adj|*-Pos-S1^aux|た-Inf-S^noun|*
 POINTS: F2 C1

#### N to N  F3
# gohan to raisu   F3
 FOCUS: noun|*^adp|と^noun|*
 POINTS: F3

#### adn + ^n*|    F3
# ookina hito ; konna hito  F3
 FOCUS: adj|大きな-Pos-S1^noun|*+adj|小さな-Pos-S1^noun|*+adj|色んな-Pos-S1^noun|*+adj|大きな-Pos-S1^part|ね^noun|*+adj|小さな-Pos-S1^part|ね^noun|*+adj|色んな-Pos-S1^part|ね^noun|*+pron|*んな-Int-S1^noun|*+pron|*んな-Int-S1^part|ね^noun|*
 POINTS: F3

#### cop + ^n*|  F3
# janai hito  D3 F3
 FOCUS: aux|だ-Inf-S^aux|ない-Inf-S^noun|*
 POINTS: D3 F3

# datta hito  D4 F3
 FOCUS: aux|だ-Inf-S^aux|た-Inf-S^noun|*
 POINTS: D4 F3

#### verben + ^n*|  F3
# taberaretakunakatta   B1 A1 A2 A4 F3
 FOCUS: aux|られる-Inf-S^aux|たい-Inf-S^adj|無い-Pos-S1^aux|た-Inf-S^noun|*+aux|れる-Inf-S^aux|たい-Inf-S^adj|無い-Pos-S1^aux|た-Inf-S^noun|*
 POINTS: B1 A1 A2 A4 F3
# taberaretakunai  B1 A1 A2 A4 F3
### FOCUS: *PASS-DESID-ADV*^v:ir:sub|ar&NEG-PRES=be^n*|*
 FOCUS: aux|られる-Inf-S^aux|たい-Inf-S^adj|無い-Pos-S1^noun|*+aux|れる-Inf-S^aux|たい-Inf-S^adj|無い-Pos-S1^noun|*
 POINTS: B1 A1 A2 A4 F3
# taberaretakatta  B1 A2 A4 F3
### FOCUS: *PASS-DESID-PAST*^n*|*
 FOCUS: aux|られる-Inf-S^aux|たい-Inf-S^aux|た-Inf-S^noun|*+aux|れる-Inf-S^aux|たい-Inf-S^aux|た-Inf-S^noun|*
 POINTS: B1 A2 A4 F3
# taberaretai  B1 A2 A4 F3
### FOCUS: *PASS-DESID-PRES*^n*|*
 FOCUS: aux|られる-Inf-S^aux|たい-Inf-S^noun|*+aux|れる-Inf-S^aux|たい-Inf-S^noun|*
 POINTS: B1 A2 A4 F3
# taberarechawanakatta   B1 A1 A1 A1 A4 F3
### FOCUS: *PASS-COMPL-NEG-PAST*^n*|*
 FOCUS: aux|られる-Inf-S^aux|ちゃう-Inf-S^aux|ない-Inf-Neg-S^aux|た-Inf-S^noun|*+aux|れる-Inf-S^aux|ちゃう-Inf-S^aux|ない-Inf-Neg-S^aux|た-Inf-S^noun|*
 POINTS: B1 A1 A1 A1 A4 F3
# taberarechawanai  B1 A1 A1 A4 F3
### FOCUS: *PASS-COMPL-NEG-PRES*^n*|*
 FOCUS: aux|られる-Inf-S^aux|ちゃう-Inf-S^aux|ない-Inf-Neg-S^noun|*+aux|れる-Inf-S^aux|ちゃう-Inf-S^aux|ない-Inf-Neg-S^noun|*
 POINTS: B1 A1 A1 A4 F3
# taberarechaimashita  B1 A1 A1 A2 A4 F3
### FOCUS: *PASS-COMPL-POL-PAST*^n*|*
 FOCUS: aux|られる-Inf-S^aux|ちゃう-Inf-S^aux|ます-Inf-S^aux|た-Inf-S^noun|*+aux|れる-Inf-S^aux|ちゃう-Inf-S^aux|ます-Inf-S^aux|た-Inf-S^noun|*
 POINTS: B1 A1 A1 A2 A4 F3
# taberarechaimasu  B1 A1 A2 A4 F3
### FOCUS: *PASS-COMPL-POL-PRES*^n*|*
 FOCUS: aux|られる-Inf-S^aux|ちゃう-Inf-S^aux|ます-Inf-S^noun|*+aux|れる-Inf-S^aux|ちゃう-Inf-S^aux|ます-Inf-S^noun|*
 POINTS: B1 A1 A2 A4 F3
 # taberarechatta  B1 A1 A4 F3
### FOCUS: *PASS-COMPL-PAST*^n*|*
 FOCUS: aux|られる-Inf-S^aux|ちゃう-Inf-S^aux|た-Inf-S^noun|*+aux|れる-Inf-S^aux|ちゃう-Inf-S^aux|た-Inf-S^noun|*
 POINTS: B1 A1 A4 F3
# taberarechau  B1 A1 A4 F3
### FOCUS: *PASS-COMPL-PRES*^n*|*
 FOCUS: aux|られる-Inf-S^aux|ちゃう-Inf-S^noun|*+aux|れる-Inf-S^aux|ちゃう-Inf-S^noun|*
 POINTS: B1 A1 A4 F3
# taberarenakatta   B1 A1 A4 F3
### FOCUS: *PASS-NEG-PAST*^n*|*
 FOCUS: aux|られる-Inf-S^aux|ない-Inf-Neg-S^aux|た-Inf-S^noun|*+aux|れる-Inf-S^aux|ない-Inf-Neg-S^aux|た-Inf-S^noun|*
 POINTS: B1 A1 A4 F3
# taberarenai  B1 A1 A4 F3
### FOCUS: *PASS-NEG-PRES*^n*|*
 FOCUS: aux|られる-Inf-S^aux|ない-Inf-Neg-S^noun|*+aux|れる-Inf-S^aux|ない-Inf-Neg-S^noun|*
 POINTS: B1 A1 A4 F3
# taberaremashita  B1 A2 A4 F3
### FOCUS: *PASS-POL-PAST*^n*|*
 FOCUS: aux|られる-Inf-S^aux|ます-Inf-S^aux|た-Inf-S^noun|*+aux|れる-Inf-S^aux|ます-Inf-S^aux|た-Inf-S^noun|*
 POINTS: B1 A2 A4 F3
# taberareta  B1 A4 F3
### FOCUS: *PASS-PAST*^n*|*
 FOCUS: aux|られる-Inf-S^aux|た-Inf-S^noun|*+aux|れる-Inf-S^aux|た-Inf-S^noun|*
 POINTS: B1 A4 F3
# taberareru  B1 A4 F3
### FOCUS: *PASS-PRES*^n*|*
 FOCUS: aux|られる-Inf-S^noun|*+aux|れる-Inf-S^noun|*
 POINTS: B1 A4 F3
##################### POT not separated from PASS られる-た for vowel verbs, and STEM (走れない -> 走る-ない) for consonant verbs, resp.
# tabetakunakatta   B1 A1 A2 F3
### FOCUS: *DESID-ADV^v:ir:sub|ar&NEG-PAST=be^n*|*
 FOCUS: aux|たい-Inf-S^adj|無い-Pos-S1^aux|た-Inf-S^noun|*
 POINTS: B1 A1 A2 F3
# tabetakunai  B1 A1 A2 F3
### FOCUS: *DESID-NEG-PRES*^n*|*
 FOCUS: aux|たい-Inf-S^adj|無い-Pos-S1^noun|*
 POINTS: B1 A1 A2 F3
# tabetakatta  B1 A2 F3
### FOCUS: *DESID-PAST^n*|*
 FOCUS: aux|たい-Inf-S^aux|た-Inf-S^noun|*
 POINTS: B1 A2 F3
# tabetai  B1 A2 F3
### FOCUS: *DESID-PRES*^n*|*
 FOCUS: aux|たい-Inf-S^noun|*
 POINTS: B1 A2 F3
# tabechawanakatta   B1 A1 A1 A1 F3
