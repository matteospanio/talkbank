 POINTS: I3


###############################################################################
#  conjunctions & conjunctive particles  E
###############################################################################
RULENAME: conj
# demo  E5
 FOCUS: cconj|で^adp|も
 POINTS: E5
# noni shi  datte ja sorede de dakara E4   ##### ja not separated from de
 FOCUS: sconj|の^sconj|に+sconj|しcconj|だ^part|って+cconj|で+cconj|其れ^adp|で+cconj|だ^sconj|から
 POINTS: E4
# to kara(temporal) kedo    E3
 FOCUS: sconj|と+sconj|て^sconj|から+sconj|けれど
 POINTS: E3
# kara(causal)   E2
 FOCUS: sconj|から
 POINTS: E2
